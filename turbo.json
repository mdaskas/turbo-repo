{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:migrate-reset": {
			"cache": false
		},
		"db:deploy": {
			"cache": false
		},
		"db:studio": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build", "^db:generate"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				"build/**",
				".vercel/**",
				"dist/**",
				".next/**",
				"!.next/cache/**"
			],
			"env": ["DATABASE_URL"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"dependsOn": ["^build", "^db:generate"],
			"cache": false,
			"persistent": true
		}
	}
}
